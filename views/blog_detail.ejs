<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %> | Data2Metrics Blog</title>
        <!-- Favicon -->
        <link rel="icon" type="image/png" href="/logo/d2m_logo.png">
    <meta name="description" content="<%= post.excerpt %>">
    <meta name="keywords" content="data analytics, blog, <%= post.category %>, Data2Metrics, Brenda Awino">
    <meta name="author" content="<%= post.author %>">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= post.title %> | Data2Metrics Blog">
    <meta property="og:description" content="<%= post.excerpt %>">
    <meta property="og:url" content="https://data2metrics.com/blog/<%= post.slug %>">
    <meta property="og:site_name" content="Data2Metrics Blog">
    <!-- Optionally add og:image if available -->
    <meta property="og:image" content="https://data2metrics.com/logo/d2m_social.png">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= post.title %> | Data2Metrics Blog">
    <meta name="twitter:description" content="<%= post.excerpt %>">
    <meta name="twitter:site" content="@data2metrics">
    <!-- Optionally add twitter:image if available -->
        <meta name="twitter:image" content="https://data2metrics.com/logo/d2m_social.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
                /* Carousel styles for related posts */
                .carousel-wrapper {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                }
                .slide-track {
                    display: flex;
                    gap: 2rem;
                    overflow-x: auto;
                    scroll-snap-type: x mandatory;
                    scroll-behavior: smooth;
                    -webkit-overflow-scrolling: touch;
                    scrollbar-width: none;
                    padding-bottom: 1rem;
                }
                .slide-track::-webkit-scrollbar { display: none; }
                .slide-track > * {
                    scroll-snap-align: start;
                    flex-shrink: 0;
                    width: 320px;
                    max-width: 90vw;
                }
                @media (min-width: 768px) {
                    .slide-track {
                        min-width: 0;
                    }
                    .slide-track > * {
                        width: 320px;
                    }
                }
                @media (min-width: 1024px) {
                    .slide-track {
                        min-width: 0;
                    }
                    .slide-track > * {
                        width: 340px;
                    }
                }
        html { scroll-behavior: smooth; }
        body { background-color: #0B0B0F; color: #FFFFFF; font-family: 'Inter', sans-serif; }
        .text-lavender { color: #B57EDC; }
        .bg-lavender { background-color: #B57EDC; }
        .text-pink { color: #F472B6; }
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(181, 126, 220, 0.2);
        }
        .btn-primary { background-color: #B57EDC; color: #000; transition: all 0.3s ease; }
        .btn-primary:hover { background-color: #F472B6; transform: scale(1.05); }
        .btn-outline { border: 1px solid rgba(255,255,255,0.2); transition: all 0.3s ease; }
        .btn-outline:hover { background-color: #F472B6; border-color: #F472B6; color: #000; }
        .tag { background: rgba(181, 126, 220, 0.15); border: 1px solid rgba(181, 126, 220, 0.3); }
        .blog-content h3 { font-size: 1.5rem; font-weight: 700; margin-top: 2rem; margin-bottom: 1rem; color: #FFFFFF; }
        .blog-content p { color: #9CA3AF; line-height: 1.8; margin-bottom: 1.25rem; }
        .blog-content ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1.25rem; }
        .blog-content ul li { color: #9CA3AF; line-height: 1.8; margin-bottom: 0.5rem; }
        .blog-content blockquote { border-left: 3px solid #B57EDC; padding-left: 1.5rem; margin: 2rem 0; font-style: italic; color: #D1D5DB; }
    </style>
</head>
<body class="overflow-x-hidden">

    <!-- Navbar -->
    <nav class="fixed top-0 w-full bg-[#0B0B0F]/80 backdrop-blur-md z-50 border-b border-gray-800/50">
        <div class="flex justify-between items-center p-6 max-w-7xl mx-auto">
            <div class="flex items-center gap-3">
                <a href="/">
                    <img src="/logo/d2m_logo.png" alt="Data2Metrics Logo" class="h-14 w-auto" style="max-height:64px;" />
                </a>
                <a href="/" class="text-2xl font-bold tracking-tighter">Data<span class="text-lavender">2</span>Metrics</a>
            </div>
            <div class="space-x-8 hidden md:flex text-sm text-gray-400 items-center">
                <a href="/#services" class="hover:text-pink transition">Services</a>
                <a href="/#portfolio" class="hover:text-pink transition">Work</a>
                <a href="/#blog" class="hover:text-pink transition">Blog</a>
                <a href="/#contact" class="btn-primary px-5 py-2 rounded-full font-semibold">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Article Header -->
    <header class="pt-28 pb-8">
        <div class="max-w-5xl mx-auto px-6">
            <a href="/#blog" class="text-gray-500 text-sm hover:text-pink transition inline-flex items-center gap-2 mb-8">
                <i class="fas fa-arrow-left"></i> Back to Blog
            </a>
            <span class="tag px-3 py-1 rounded-full text-xs text-lavender inline-block mb-4"><%= post.category %></span>
            <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6"><%= post.title %></h1>
            <div class="flex items-center gap-4 text-gray-500 text-sm">
                <span><i class="far fa-calendar mr-1"></i> <%= post.date %></span>
                <span><i class="far fa-clock mr-1"></i> <%= post.readTime %></span>
                <span><i class="far fa-user mr-1"></i> <%= post.author %></span>
            </div>
        </div>
    </header>

    <!-- Article Content -->
    <section class="max-w-5xl mx-auto px-6 pb-24">
        <div class="glass-card rounded-2xl p-8 md:p-12 mb-12 blog-content">
            <%- post.content %>
        </div>

        <!-- Author Box -->
        <div class="glass-card rounded-2xl p-8 flex flex-col sm:flex-row items-center gap-6 mb-12">
            <div class="w-16 h-16 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-2xl font-bold shrink-0">BA</div>
            <div>
                <p class="font-bold mb-1"><%= post.author %></p>
                <p class="text-gray-400 text-sm">Data Analytics Consultant at Data2Metrics. Passionate about turning messy data into clear, actionable insights for businesses across Africa and beyond.</p>
            </div>
        </div>

        <!-- CTA -->
        <div class="text-center">
            <p class="text-gray-400 mb-6">Want expert help with your data challenges?</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="/#contact" class="btn-primary px-8 py-4 rounded-lg font-bold">Get in Touch</a>
                <a href="/#blog" class="btn-outline px-8 py-4 rounded-lg font-bold">Read More Articles</a>
            </div>
        </div>
    </section>

    <!-- Related Posts -->
    <section class="max-w-5xl mx-auto px-6 pb-24">
        <h2 class="text-2xl font-bold mb-8">Related Posts</h2>
        <div class="carousel-wrapper">
            <button class="slide-btn hidden md:flex" onclick="slideScroll('related-posts-track', -1)"><i class="fas fa-chevron-left"></i></button>
            <div id="related-posts-track" class="slide-track" data-auto-slide>
                <% relatedPosts.forEach(rp => { %>
                    <a href="/blog/<%= rp.slug %>" class="glass-card rounded-2xl p-6 flex flex-col gap-2 hover:border-pink hover:shadow-lg transition w-[320px] md:w-[360px]">
                        <span class="tag px-3 py-1 rounded-full text-xs text-lavender w-max"><%= rp.category %></span>
                        <h3 class="font-bold text-lg mb-1"><%= rp.title %></h3>
                        <p class="text-gray-400 text-sm mb-2"><%= rp.excerpt %></p>
                        <div class="flex items-center gap-2 text-xs text-gray-500">
                            <span><i class="far fa-calendar mr-1"></i> <%= rp.date %></span>
                            <span><i class="far fa-user mr-1"></i> <%= rp.author %></span>
                        </div>
                    </a>
                <% }) %>
            </div>
            <button class="slide-btn hidden md:flex" onclick="slideScroll('related-posts-track', 1)"><i class="fas fa-chevron-right"></i></button>
        </div>
    </section>

      <!-- Footer: quick links and contact info -->
    <footer class="border-t border-gray-900 py-8">
        <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8 mb-6">
            <div>
                <div class="text-lg font-bold tracking-tighter mb-2">Data<span class="text-lavender">2</span>Metrics</div>
                <p class="text-gray-500 text-xs">Turning raw data into real insight. Helping you see the story behind every number.</p>
            </div>
            <div>
                <p class="font-semibold mb-2 text-xs">Quick Links</p>
                <div class="space-y-1 text-xs text-gray-500">
                    <a href="#services" class="block hover:text-pink transition">Services</a>
                    <a href="#portfolio" class="block hover:text-pink transition">Work</a>
                    <a href="#blog" class="block hover:text-pink transition">Blog</a>
                    <a href="#contact" class="block hover:text-pink transition">Contact</a>
                </div>
            </div>
            <div>
                <p class="font-semibold mb-2 text-xs">Connect</p>
                <p class="text-gray-600 text-xs">brenda@data2metrics.com</p>
                <p class="text-gray-600 text-xs">+254 703 462 665</p>
                <p class="text-gray-600 text-xs">Nairobi, Kenya</p>
                <!-- Social links -->
                <div class="flex gap-4 mt-4 text-lg text-gray-500">
                    <a href="#" aria-label="Twitter" class="hover:text-pink transition"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="LinkedIn" class="hover:text-pink transition"><i class="fab fa-linkedin"></i></a>
                    <a href="#" aria-label="Instagram" class="hover:text-pink transition"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="GitHub" class="hover:text-pink transition"><i class="fab fa-github"></i></a>
                </div>
            </div>
        </div>
        <div class="text-center text-gray-600 text-xs border-t border-gray-900 pt-6">
            <p>&copy; 2026 Data2Metrics. Precision in every pixel.</p>
        </div>
    </footer>

<script>
// Carousel: scrolls one card at a time when arrow is clicked
function slideScroll(trackId, direction) {
    const track = document.getElementById(trackId);
    const card = track.querySelector('.glass-card');
    const gap = 32; // 2rem gap
    const cardWidth = card.offsetWidth + gap;
    // Calculate nearest card-aligned position
    const currentIndex = Math.round(track.scrollLeft / cardWidth);
    const nextIndex = Math.max(0, currentIndex + direction);
    track.scrollTo({ left: nextIndex * cardWidth, behavior: 'smooth' });
}
// Carousel: auto-slide cards every few seconds, pause on hover/touch
document.querySelectorAll('[data-auto-slide]').forEach(track => {
    let interval;
    const gap = 32;
    function getCardWidth() {
        const card = track.querySelector('.glass-card');
        return card ? card.offsetWidth + gap : 400;
    }
    function startAuto() {
        interval = setInterval(() => {
            const cardWidth = getCardWidth();
            const maxScroll = track.scrollWidth - track.clientWidth;
            const currentIndex = Math.round(track.scrollLeft / cardWidth);
            if (track.scrollLeft >= maxScroll - 5) {
                track.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
                track.scrollTo({ left: (currentIndex + 1) * cardWidth, behavior: 'smooth' });
            }
        }, 4000);
    }
    startAuto();
    // Pause on hover
    track.addEventListener('mouseenter', () => clearInterval(interval));
    track.addEventListener('mouseleave', () => startAuto());
    // Pause on touch
    track.addEventListener('touchstart', () => clearInterval(interval), { passive: true });
    track.addEventListener('touchend', () => startAuto());
});
</script>

<!-- Sticky WhatsApp Button -->
<a href="https://wa.me/254703462665?text=Hi%20I%20want%20to%20learn%20more%20about%20Data2Metrics" target="_blank" aria-label="Chat on WhatsApp"
   class="fixed bottom-6 right-6 bg-green-500 text-white px-5 py-3 rounded-full shadow-lg flex items-center gap-2 hover:scale-105 transition z-50">
    <i class="fab fa-whatsapp"></i>
    <span class="text-sm font-semibold">Chat on WhatsApp</span>
</a>

</body>
</html>
