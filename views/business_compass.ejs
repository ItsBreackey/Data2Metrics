    const activities = [
    "Someone in Nairobi just started Growth plan",
    "New business tracked KES 120,000 revenue",
    "Retail shop increased profit by 18%",
    "Another user unlocked Premium insights",
];

    function runActivityFeed() {
        const feed = document.getElementById("activityFeed");

        setInterval(() => {
            const item = document.createElement("div");
            item.className = "glass px-4 py-2 rounded-lg text-gray-300";

            item.innerText = activities[Math.floor(Math.random() * activities.length)];

            feed.appendChild(item);

            setTimeout(() => item.remove(), 5000);

        }, 4000);
    }

    runActivityFeed();

    function runThinkingSequence(callback) {
    const overlay = document.getElementById("thinkingOverlay");
    const text = document.getElementById("thinkingText");
    const bar = document.getElementById("progressBar");

    overlay.classList.remove("hidden");

    const steps = [
        "Reading financial patterns...",
        "Calculating profit margins...",
        "Detecting spending leaks...",
        "Comparing industry benchmarks...",
        "Generating best plan..."
    ];

    let i = 0;
    let progress = 0;

    const interval = setInterval(() => {
        text.innerText = steps[i] || steps[steps.length - 1];

        progress += 20;
        bar.style.width = progress + "%";

        i++;

        if (i >= steps.length) {
            clearInterval(interval);

            setTimeout(() => {
                overlay.classList.add("hidden");
                callback(); // reveal results AFTER thinking
            }, 500);
        }
    }, 600);
}

    function generateReport() {
    const revenue = Number(document.getElementById("revenue").value);
    const expenses = Number(document.getElementById("expenses").value);
    const customers = Number(document.getElementById("customers").value);

    const profit = revenue - expenses;
    const margin = (profit / revenue) * 100;

    let plan = "Basic";
    let insight = "";
    let risk = "";

    if (revenue < 50000) plan = "Basic";
    else if (revenue < 120000) plan = "Growth";
    else plan = "Premium";

    if (margin < 10) {
        insight = "Your profit margin is very low. Expenses are consuming growth.";
        risk = "High";
    } else if (margin < 25) {
        insight = "Decent revenue, but there’s room to optimize efficiency.";
        risk = "Medium";
    } else {
        insight = "Strong profitability. You're in a scaling position.";
        risk = "Low";
    }

    return { revenue, expenses, customers, profit, margin, plan, insight, risk };
}

    function runAnalysis() {
    const thinking = document.getElementById("thinking");
    const report = document.getElementById("report");

    report.innerHTML = "";
    thinking.classList.remove("hidden");

    const steps = [
        "Scanning financial data...",
        "Calculating profit margins...",
        "Benchmarking performance...",
        "Generating recommendation..."
    ];

    let i = 0;

    const interval = setInterval(() => {
        thinking.innerText = steps[i];
        i++;

        if (i === steps.length) {
            clearInterval(interval);

            setTimeout(() => {
                thinking.classList.add("hidden");
                const data = generateReport();
                showReport(data);
            }, 500);
        }
    }, 700);
}

let selectedPlan = null;
function showReport(r) {
    selectedPlan = r.plan; // default to recommended
    document.getElementById("report").innerHTML = `
        <div class="glass-card p-6 rounded-xl">
            <h2 class="text-xl font-bold text-lavender mb-4">
                📊 Business Decision Report
            </h2>
            <p><b>Revenue:</b> KES ${r.revenue.toLocaleString()}</p>
            <p><b>Expenses:</b> KES ${r.expenses.toLocaleString()}</p>
            <p><b>Profit:</b> KES ${r.profit.toLocaleString()}</p>
            <p><b>Margin:</b> ${r.margin.toFixed(1)}%</p>
            <hr class="my-4 border-gray-700">
            <p><b>Risk Level:</b> ${r.risk}</p>
            <p class="text-gray-300 mt-2">${r.insight}</p>
            <hr class="my-4 border-gray-700">
            <p><b>Recommended Plan:</b> 
                <span class="text-pink font-bold" id="selectedPlanName">${r.plan}</span>
            </p>
            <button onclick="sendWhatsApp(${r.revenue}, selectedPlan)"
                class="btn-primary mt-6 w-full py-3 rounded-lg continue-whatsapp-btn">
                <b>Continue on WhatsApp</b>
            </button>
       

        <style>
            .continue-whatsapp-btn:hover {
                background-color: #F472B6 !important;
                color: #000 !important;
                transition: background 0.2s, color 0.2s;
            }
        </style>
        </div>
    `;
    // Always show pricing section after report
    const pricing = document.getElementById('pricing');
    pricing.classList.remove('hidden');
    // Highlight recommended plan
    highlightPlanCard(r.plan);
    // Set up plan selection
    setupPlanSelection(r);
}

function setupPlanSelection(r) {
    const planCards = document.querySelectorAll('#planCards .glass-card');
    planCards.forEach(card => {
        card.classList.remove('ring-4', 'ring-pink-400');
    });
    document.querySelectorAll('.choose-plan-btn').forEach(btn => {
        btn.onclick = function() {
            const plan = btn.closest('.glass-card').getAttribute('data-plan');
            selectedPlan = plan;
            // Update highlight
            highlightPlanCard(plan);
            // Update plan name in report
            const planName = document.getElementById('selectedPlanName');
            if (planName) planName.textContent = plan;
            // Update WhatsApp links
            updateWhatsAppLinks(r.revenue, plan);
        };
    });
    // Set WhatsApp links for all plans
    updateWhatsAppLinks(r.revenue, selectedPlan);
}

function highlightPlanCard(plan) {
    const planCards = document.querySelectorAll('#planCards .glass-card');
    planCards.forEach(card => {
        if (card.getAttribute('data-plan') === plan) {
            card.classList.add('ring-4', 'ring-pink-400');
        } else {
            card.classList.remove('ring-4', 'ring-pink-400');
        }
    });
}

function updateWhatsAppLinks(revenue, plan) {
    const msg = encodeURIComponent(
`Hi Data2Metrics 👋\n\nI just generated my Business Decision Report.\n\nRevenue: ${revenue}\nSelected Plan: ${plan}\n\nI want help setting this up.`
    );
    document.querySelectorAll('.get-started-link').forEach(link => {
        link.href = `https://wa.me/254703462665?text=${msg}`;
    });
}

function sendWhatsApp(revenue, plan) {
    const msg = encodeURIComponent(
`Hi Data2Metrics 👋

I just generated my Business Decision Report.

Revenue: ${revenue}
Recommended Plan: ${plan}

I want help setting this up.`
    );

    window.open(`https://wa.me/254703462665?text=${msg}`, "_blank");
}

