<script>

    function updateDashboard(rev, exp, profit) {
        document.getElementById("rev").innerHTML = "KES " + rev.toLocaleString();
        document.getElementById("exp").innerHTML = "KES " + exp.toLocaleString();
        document.getElementById("profit").innerHTML = "KES " + profit.toLocaleString();
    }

    // Animate demo numbers on page load

    function animateDashboardDemo() {
        // More realistic demo values
        const demoRev = 120000;
        const demoExp = 83000;
        const demoProfit = demoRev - demoExp;
        let rev = 0, exp = 0, profit = 0;
        const steps = 60; // slower animation
        let i = 0;
        const interval = setInterval(() => {
            i++;
            rev = Math.floor(demoRev * i / steps);
            exp = Math.floor(demoExp * i / steps);
            profit = rev - exp;
            updateDashboard(rev, exp, profit);
            if (i >= steps) {
                updateDashboard(demoRev, demoExp, demoProfit);
                clearInterval(interval);
            }
        }, 40);
    }

    window.addEventListener('DOMContentLoaded', animateDashboardDemo);

    function openModal() {
    const modal = document.getElementById('demoModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex'); // IMPORTANT
    }

    function closeModal() {
        const modal = document.getElementById('demoModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    // Fade-in
    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) entry.target.classList.add('visible');
        });
    });

    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

