    <style>
        html { scroll-behavior: smooth; }
        body {
            background-color: #0B0B0F;
            color: #FFFFFF;
            font-family: 'Inter', sans-serif;
        }
        .text-lavender { color: #B57EDC; }
        .bg-lavender { background-color: #B57EDC; }
        .text-pink { color: #F472B6; }
        .bg-pink { background-color: #F472B6; }
        .border-lavender { border-color: rgba(181, 126, 220, 0.3); }

        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(181, 126, 220, 0.2);
            transition: all 0.3s ease;
        }
        .glass-card:hover {
            border-color: #F472B6;
            box-shadow: 0 0 20px rgba(244, 114, 182, 0.2);
            transform: translateY(-5px);
        }

        .hero-glow {
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(181, 126, 220, 0.15) 0%, rgba(11, 11, 15, 0) 70%);
            z-index: -1;
        }
        .hero-glow-right {
            position: absolute;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(244, 114, 182, 0.1) 0%, rgba(11, 11, 15, 0) 70%);
            z-index: -1;
            right: 0;
            top: 50%;
        }

        /* Fade-in animation */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }
        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Methodology connector */
        .step-connector { position: relative; }
        .step-connector::after {
            content: '';
            position: absolute;
            top: 24px;
            left: calc(50% + 30px);
            width: calc(100% - 60px);
            height: 2px;
            background: linear-gradient(90deg, #B57EDC, #F472B6);
            opacity: 0.3;
        }
        .step-connector:last-child::after { display: none; }

        /* Testimonial quote */
        .quote-mark {
            font-size: 4rem;
            line-height: 1;
            background: linear-gradient(135deg, #B57EDC, #F472B6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Navbar hide on scroll */
        .main-nav {
            transition: transform 0.35s ease;
        }
        .main-nav.nav-hidden {
            transform: translateY(-100%);
        }

        /* Sliding carousel */
        .slide-track {
            display: flex;
            gap: 2rem;
            overflow-x: hidden;
            scroll-snap-type: x mandatory;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            padding-bottom: 1rem;
        }
        .slide-track::-webkit-scrollbar { display: none; }
        .slide-track > * {
            scroll-snap-align: start;
            flex-shrink: 0;
        }
        /* Slide nav buttons */
        .slide-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 1px solid rgba(181, 126, 220, 0.3);
            background: rgba(255,255,255,0.05);
            color: #B57EDC;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .slide-btn:hover {
            background: #F472B6;
            color: #000;
            border-color: #F472B6;
        }

        /* Carousel wrapper: arrows flanking cards */
        .carousel-wrapper {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .carousel-wrapper .slide-track {
            flex: 1;
            min-width: 0;
        }

        /* Pink hover for CTA buttons */
        .btn-primary {
            background-color: #B57EDC;
            color: #000;
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            background-color: #F472B6;
            transform: scale(1.05);
        }
        .btn-outline {
            border: 1px solid rgba(255,255,255,0.2);
            transition: all 0.3s ease;
        }
        .btn-outline:hover {
            background-color: #F472B6;
            border-color: #F472B6;
            color: #000;
        }

        /* Dot navigation */
        .dot-nav {
            position: fixed;
            right: 1.5rem;
            top: 50%;
            transform: translateY(-50%);
            z-index: 40;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }
        .dot-nav a {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(181, 126, 220, 0.25);
            border: 1px solid rgba(181, 126, 220, 0.4);
            transition: all 0.3s ease;
            display: block;
        }
        .dot-nav a:hover,
        .dot-nav a.active {
            background: #F472B6;
            border-color: #F472B6;
            transform: scale(1.4);
        }
        @media (max-width: 768px) {
            .dot-nav { display: none; }
        }
    </style>
</head>
