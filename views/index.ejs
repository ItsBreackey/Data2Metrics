        <p class="text-gray-400 mb-8 fade-in">See your profit, expenses, and growth opportunities in minutes.</p>
        <form class="glass-card p-6 rounded-2xl text-left fade-in" onsubmit="event.preventDefault(); handleContact(this);">
            <div class="grid md:grid-cols-2 gap-6 mb-4">
                <div>
                    <label class="block text-xs uppercase tracking-widest text-gray-500 mb-1">Name</label>
                    <input type="text" name="name" required class="w-full bg-transparent border-b border-gray-700 py-2 focus:border-pink outline-none transition text-white">
                </div>
                <div>
                    <label class="block text-xs uppercase tracking-widest text-gray-500 mb-1">Email</label>
                    <input type="email" name="email" required class="w-full bg-transparent border-b border-gray-700 py-2 focus:border-pink outline-none transition text-white">
                </div>
            </div>
            <div class="mb-4">
                <label class="block text-xs uppercase tracking-widest text-gray-500 mb-1">Message</label>
